//kage:unit pixels

package main

// ScreenSize は描画先の寸法。ビネットの中心と正規化に使う。
var ScreenSize vec2

// Darkness は暗さの度合い。0 で原画のまま、1 で最も暗い。ビネットとコントラストの強さに使う。
var Darkness float

// Fragment はライトマップ乗算済みの世界フレームへ、仕上げのビネットと軽いコントラストをかける。
// 光だまりの位置や色はライトマップ側で済んでいるので、ここは全体の締めだけ担う。
func Fragment(dstPos vec4, srcPos vec2, _ vec4) vec4 {
	base := imageSrc0At(srcPos)
	lit := base.rgb

	// ビネット。暗いほど強くかける
	p := dstPos.xy - imageDstOrigin()
	center := ScreenSize * 0.5
	vd := distance(p, center) / length(center)
	vig := 1.0 - smoothstep(0.42, 1.0, vd)*0.72*Darkness
	lit *= vig

	// 軽いコントラスト。暗いほど効かせる
	contrasted := (lit-vec3(0.5))*1.12 + vec3(0.5)
	lit = mix(lit, contrasted, Darkness)

	return vec4(lit, base.a)
}
