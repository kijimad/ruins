// SteamPipe アプリビルド定義。Makefile が @...@ を実値へ展開する。テンプレートなので直接編集しない。
// OS 別に depot を2つに分ける。Linux 実行体は Linux depot、Windows 実行体は Windows depot へ。
// depot ごとの OS 割当(oslist)は Steamworks の depot 設定で行う。ここは content の割り当てだけ。
"AppBuild"
{
	"AppID"       "@APP_ID@"
	"Desc"        "@DESC@"

	// depot ごとに ContentRoot を持つので、ここは基準ディレクトリだけ置く
	"ContentRoot" "@CONTENT_ROOT@"
	"BuildOutput" "@OUTPUT@"

	// 1 のときアップロードせず内容の検証だけ行う。make preview がここを 1 にする。
	"Preview"     "@PREVIEW@"
	// 名前付きブランチへ自動反映するとき指定。default は指定不可で Web で確定する。空なら反映しない。
	"SetLive"     "@SETLIVE@"

	"Depots"
	{
		"@DEPOT_LINUX@"   "@DEPOT_LINUX_VDF@"
		"@DEPOT_WINDOWS@" "@DEPOT_WINDOWS_VDF@"
	}
}
