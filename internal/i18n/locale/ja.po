msgstr "骨で作られた不気味な歯車"

msgid "Yellow Orb"
msgstr "黄色い球"

msgid "A springy yellow sphere. Its use is unknown."
msgstr "黄色い弾力のある球体。何に使えるか不明"

msgid "Yellow Wire"
msgstr "黄色い電線"

